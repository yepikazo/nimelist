# Create a private local copy at repository root as .env.server2.
# Use random hexadecimal values; do not commit the local copy.
POSTGRES_ADMIN_PASSWORD=replace_with_random_secret
CATALOG_DB_PASSWORD=replace_with_random_secret
SCHEDULE_DB_PASSWORD=replace_with_random_secret
SEARCH_DB_PASSWORD=replace_with_random_secret
REDIS_PASSWORD=replace_with_random_secret
INTERNAL_API_TOKEN=replace_with_at_least_32_random_characters

# These ports bind to localhost only.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
CATALOG_HOST_PORT=4101
SCHEDULE_HOST_PORT=4102
SEARCH_HOST_PORT=4103
